{
	# Every hostname here is loopback-only, so ACME must never be attempted.
	auto_https disable_redirects
	admin 0.0.0.0:2019
}

# Per-project site files are generated by `dragonrun register` into
# $DRAGONRUN_HOME/caddy/sites/<name>.caddy and picked up by a `caddy reload`.
# Nothing in this file changes as projects come and go.
import /etc/caddy/sites/*.caddy
