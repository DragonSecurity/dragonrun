{
	# Every hostname here is loopback-only, so ACME must never be attempted.
	auto_https disable_redirects
	admin 0.0.0.0:2019

	# `tls internal` defaults to a 12-hour leaf off a 7-day intermediate.
	# That suits a server that is always up to renew them; a dev edge that is
	# stopped overnight just serves an expired certificate in the morning.
	#
	# The leaf lifetime is a per-site setting and lives in the generated site
	# files. The intermediate is a global one and has to be raised too --
	# caddy truncates a leaf to its issuer's notAfter, so a long leaf under a
	# 7-day intermediate is still a 7-day certificate.
	#
	# Must match edge.IntermediateLifetime; TestCaddyfileMatchesIntermediateLifetime
	# holds the two together.
	pki {
		ca local {
			intermediate_lifetime 8760h
		}
	}
}

# Per-project site files are generated by `dragonrun register` into
# $DRAGONRUN_HOME/caddy/sites/<name>.caddy and picked up by a `caddy reload`.
# Nothing in this file changes as projects come and go.
import /etc/caddy/sites/*.caddy
